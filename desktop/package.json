{
  "name": "dancefloor-builder-desktop",
  "productName": "Dancefloor Builder",
  "version": "1.0.1",
  "private": true,
  "description": "Dancefloor Builder — playlist builder for DJs",
  "author": "Exceptional Entertainment",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.exceptionalentertainment.dancefloorbuilder",
    "productName": "Dancefloor Builder",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": ["main.cjs", "package.json"],
    "mac": {
      "category": "public.app-category.music",
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "identity": "-"
    },
    "dmg": {
      "title": "Dancefloor Builder",
      "contents": [
        { "x": 140, "y": 200, "type": "file" },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
