{
  "name": "dancefloor-builder-desktop",
  "productName": "SetArchitect",
  "version": "1.1.0",
  "private": true,
  "description": "SetArchitect \u2014 event and set programming for DJs",
  "author": "Exceptional Entertainment",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.exceptionalentertainment.dancefloorbuilder",
    "productName": "SetArchitect",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "tags.cjs",
      "build-info.json",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "notarize": true
    },
    "dmg": {
      "title": "SetArchitect",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "node-taglib-sharp": "6.0.3"
  }
}
