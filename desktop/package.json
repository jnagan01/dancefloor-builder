{
  "name": "dancefloor-builder-desktop",
  "productName": "SetArchitect",
  "version": "1.2.0",
  "private": true,
  "description": "SetArchitect \u2014 event and set programming for DJs",
  "author": "Exceptional Entertainment",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.exceptionalentertainment.dancefloorbuilder",
    "productName": "SetArchitect",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "update-controller.cjs",
      "tags.cjs",
      "security.cjs",
      "scan.cjs",
      "backups.cjs",
      "backup-policy.json",
      "recovery.cjs",
      "vdj-database.cjs",
      "offline-store.cjs",
      "offline-window.cjs",
      "offline-preload.cjs",
      "offline/index.html",
      "offline/app.js",
      "offline/core.js",
      "offline/offline.css",
      "build-info.json",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "notarize": true
    },
    "dmg": {
      "title": "SetArchitect",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "artifactName": "SetArchitect-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "node-taglib-sharp": "6.0.3",
    "electron-updater": "6.6.2",
    "builder-util-runtime": "9.3.1",
    "semver": "7.7.3"
  }
}
